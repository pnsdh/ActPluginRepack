<Project Sdk="Microsoft.NET.Sdk">

  <!-- 명령줄 프런트엔드: 옵션을 읽어 Core 를 부르고 결과를 콘솔에 보여 준다 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ActPluginRepack</AssemblyName>
    <RootNamespace>ActPluginRepack</RootNamespace>
    <ApplicationIcon>..\ActPluginRepack.Gui\Assets\app.ico</ApplicationIcon>
    <!-- 관리자 권한으로도 실행되므로 DOTNET_STARTUP_HOOKS 로 코드를 끼워 넣는 길 하나를 막는다 (같은 사용자는 앱 폴더 자체를 바꿀 수 있어 완전한 방어는 아님) -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ActPluginRepack.Core\ActPluginRepack.Core.csproj" />
    <Using Include="FFXIV.Signatures" />
  </ItemGroup>

</Project>
