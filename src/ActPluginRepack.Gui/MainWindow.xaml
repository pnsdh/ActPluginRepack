<ui:FluentWindow x:Class="ActPluginRepack.Gui.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:ActPluginRepack.Gui.ViewModels"
                 xmlns:views="clr-namespace:ActPluginRepack.Gui.Views"
                 xmlns:gui="clr-namespace:ActPluginRepack.Gui"
                 Title="{x:Static gui:Titles.AppWithVersion}"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="960" Height="700" MinWidth="720" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{StaticResource AppFont}">
    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RunViewModel}"><views:RunView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SetupViewModel}"><views:SetupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdvancedViewModel}"><views:AdvancedView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HelpViewModel}"><views:HelpView /></DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static gui:Titles.AppWithVersion}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 위쪽 막대: 처음으로 / 진행 방식 / 도움말 / 설정 -->
        <Grid Grid.Row="1" Margin="24,4,24,0" IsEnabled="{Binding CanNavigate}">
            <ui:Button Content="처음으로" Icon="{ui:SymbolIcon Home24}" Appearance="Transparent"
                       Command="{Binding GoHomeCommand}" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="고급 모드" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:ToggleSwitch IsChecked="{Binding IsAdvanced}" Margin="0,0,16,0" AutomationProperties.Name="고급 모드"
                                 ToolTip="작업을 직접 골라서 실행합니다 (익숙한 사용자용)." />
                <ui:Button Content="{x:Static gui:Titles.Help}" Icon="{ui:SymbolIcon QuestionCircle24}" Appearance="Transparent" Margin="0,0,4,0"
                           Command="{Binding GoHelpCommand}" ToolTip="문제 보고용 기록 저장, 디스코드, 자주 묻는 질문이 있습니다." />
                <ui:Button Content="설정" Icon="{ui:SymbolIcon Settings24}" Appearance="Transparent"
                           Command="{Binding GoSettingsCommand}" />
            </StackPanel>
        </Grid>

        <!-- 새 버전 / 자동 업데이트 (모든 화면 공통, 작업 중에는 누를 수 없음) -->
        <StackPanel Grid.Row="2" Margin="24,8,24,0" DataContext="{Binding Update}"
                    IsEnabled="{Binding DataContext.CanNavigate, RelativeSource={RelativeSource AncestorType=Window}}">
            <ui:InfoBar Title="업데이트 완료" Message="{Binding UpdatedNotice, Converter={StaticResource KeepAll}}" Severity="Success" IsClosable="True"
                        IsOpen="{Binding ShowUpdated, Mode=TwoWay}"
                        Visibility="{Binding ShowUpdated, Converter={StaticResource Visible}}" />
            <ui:Card Padding="16,10" Visibility="{Binding Notice, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="ArrowCircleUp24" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Notice, Converter={StaticResource KeepAll}}" Style="{StaticResource Body}"
                               Margin="12,0" VerticalAlignment="Center" ToolTip="{Binding NoticeDetail}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,8,0"
                                         Visibility="{Binding Updating, Converter={StaticResource Visible}}" />
                        <ui:Button Content="지금 업데이트" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding UpdateNowCommand}"
                                   Visibility="{Binding ShowUpdateButton, Converter={StaticResource Visible}}"
                                   ToolTip="새 버전을 받아 바꿔 넣고 프로그램을 다시 실행합니다. 받은 파일이 손상됐거나 바꿔 넣지 못하면 지금 버전을 그대로 둡니다." />
                        <ui:Button Content="직접 받기" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenReleaseCommand}" Margin="8,0,0,0"
                                   Visibility="{Binding ShowManualButton, Converter={StaticResource Visible}}"
                                   ToolTip="새 버전 페이지를 엽니다. 받은 zip 의 파일로 지금 폴더의 파일을 바꾸면 됩니다." />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </StackPanel>

        <!-- 자동 업데이트 중에는 화면의 버튼을 누를 수 없다 (작업을 시작하지 못하게) -->
        <ContentControl Grid.Row="3" Content="{Binding CurrentPage}" Margin="24,8,24,24" Focusable="False"
                        IsEnabled="{Binding PageEnabled}" />
    </Grid>
</ui:FluentWindow>
