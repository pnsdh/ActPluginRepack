<Application x:Class="ActPluginRepack.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Views/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 앱 글꼴 (WPF-UI 컨트롤이 쓰는 키도 덮어쓴다) -->
            <FontFamily x:Key="AppFont">pack://application:,,,/Fonts/#Pretendard</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">pack://application:,,,/Fonts/#Pretendard</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
