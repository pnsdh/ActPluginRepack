<UserControl x:Class="ActPluginRepack.Gui.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:gui="clr-namespace:ActPluginRepack.Gui">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Center">
            <!-- 제목은 이 화면을 여는 버튼 이름과 같게 -->
            <TextBlock Text="{x:Static gui:Titles.GameLocation}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Body}" Margin="0,0,0,16"
                       Text="{Binding Intro, Converter={StaticResource KeepAll}}" />

            <ui:Card Padding="12">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Clients}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding InstallDir}" />
                                        <StackPanel Grid.Column="1" Margin="4,0,12,0">
                                            <TextBlock Text="{Binding InstallDir}" FontSize="14" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" ToolTip="{Binding InstallDir}" />
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="게임 버전" /> <Run Text="{Binding Version, Mode=OneWay, TargetNullValue=모름}" />
                                                <Run Text="  ·  찾은 곳:" /> <Run Text="{Binding Source, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding Regions}" SelectedItem="{Binding Region}"
                                                  VerticalAlignment="Center" ToolTip="이 클라이언트의 지역입니다."
                                                  AutomationProperties.Name="{Binding InstallDir, StringFormat='{}{0} 의 지역'}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource RegionLabel}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="4,10,0,0">
                        <ui:Button Content="폴더 직접 고르기" Icon="{ui:SymbolIcon FolderAdd24}" Command="{Binding AddFolderCommand}" />
                        <ui:Button Content="다시 찾기" Icon="{ui:SymbolIcon Search24}" Appearance="Transparent" Margin="8,0,0,0"
                                   Command="{Binding DetectCommand}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- ACT -->
            <ui:Card Margin="0,12,0,0" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="PlugConnected24" FontSize="22" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding ActStatus, Converter={StaticResource KeepAll}}" Style="{StaticResource Body}" Margin="12,0,0,0" />
                </Grid>
            </ui:Card>

            <ui:InfoBar Title="확인하세요" Message="{Binding Error, Converter={StaticResource KeepAll}}" Severity="Error" IsOpen="True" IsClosable="False" Margin="0,12,0,0"
                        Visibility="{Binding Error, Converter={StaticResource Visible}}" />

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <ui:Button Content="저장" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Padding="24,8" Command="{Binding SaveCommand}" />
                <!-- Esc 로는 취소하지 않는다 (지역 목록을 고르다 누른 Esc 로 직접 추가한 폴더를 잃지 않게) -->
                <ui:Button Content="취소" Margin="12,0,0,0" Command="{Binding CancelCommand}"
                           Visibility="{Binding FirstRun, Converter={StaticResource Visible}, ConverterParameter=invert}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
