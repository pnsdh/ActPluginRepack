<UserControl x:Class="ActPluginRepack.Gui.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:gui="clr-namespace:ActPluginRepack.Gui">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Center" Margin="0,24,0,0">


            <!-- 지금 상태: 큰 아이콘 + 제목 + 설명 + 버튼 하나 -->
            <ui:Card Padding="32">
                <StackPanel>
                    <ui:SymbolIcon Symbol="{Binding Kind, Converter={StaticResource ResultIcon}}" FontSize="56"
                                   Foreground="{Binding Kind, Converter={StaticResource StateBrush}}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding Headline, Converter={StaticResource KeepAll}}" Style="{StaticResource Headline}" FontSize="24" Margin="0,16,0,8" />
                    <TextBlock Text="{Binding Description, Converter={StaticResource KeepAll}}" Style="{StaticResource Body}" FontSize="15" />

                    <ui:InfoBar Title="알림" Message="{Binding Info, Converter={StaticResource KeepAll}}" Severity="Informational" IsClosable="False" IsOpen="True"
                                Margin="0,16,0,0" Visibility="{Binding Info, Converter={StaticResource Visible}}" />
                    <ui:InfoBar Title="먼저 확인하세요" Message="{Binding Notice, Converter={StaticResource KeepAll}}" Severity="Warning" IsClosable="False" IsOpen="True"
                                Margin="0,16,0,0" Visibility="{Binding Notice, Converter={StaticResource Visible}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <!-- 주 버튼은 IsDefault 가 아니다: 진행 화면의 [확인]을 Enter 로 누른 뒤 Enter 가 이어지면(꾹 누름, 두 번 누름)
                             돌아온 이 화면에서 바로 설치가 다시 시작될 수 있다 -->
                        <ui:Button Content="{Binding PrimaryText}" Appearance="Primary" Icon="{ui:SymbolIcon Wrench24}"
                                   FontSize="16" Padding="24,10" Command="{Binding FixCommand}" IsEnabled="{Binding CanFix}" />
                        <ui:Button Content="새로 고침" Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="12,0,0,0" Padding="16,10"
                                   Appearance="Transparent" Command="{Binding RefreshCommand}"
                                   Visibility="{Binding ShowRefresh, Converter={StaticResource Visible}}"
                                   ToolTip="화면의 정보만 다시 읽습니다 (인터넷을 쓰지 않음)." />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- 부가: 지금 정보, 되돌리기, 게임 위치 -->
            <ui:Card Margin="0,12,0,0" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Details, Converter={StaticResource KeepAll}}" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Content="{x:Static gui:Titles.Restore}" Icon="{ui:SymbolIcon ArrowUndo24}" Appearance="Transparent"
                                   Command="{Binding RestoreCommand}"
                                   ToolTip="이 프로그램이 고친 플러그인 대신 공식 FFXIV 플러그인을 ACT 에 설치합니다. 고친 플러그인으로 문제가 생겼을 때 누르세요."
                                   Visibility="{Binding CanRestore, Converter={StaticResource Visible}}" />
                        <ui:Button Content="{x:Static gui:Titles.GameLocation}" Icon="{ui:SymbolIcon Folder24}" Appearance="Transparent"
                                   Command="{Binding EditGamesCommand}" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <TextBlock Style="{StaticResource Caption}" Margin="4,16,4,0"
                       Text="{Binding Source='게임이 업데이트됐는데 ACT 플러그인 업데이트가 아직 나오지 않았을 때, 지금 플러그인을 임시로 고쳐 쓰게 해 주는 프로그램입니다. 공식 업데이트가 나오면 평소처럼 해루봇에서 FFXIV 플러그인을 업데이트하면 됩니다.', Converter={StaticResource KeepAll}}" />
            <!-- 문제가 생겼을 때 찾아갈 곳 (창 윗줄의 [도움말]과 같은 화면) -->
            <StackPanel Orientation="Horizontal" Margin="4,4,4,0">
                <TextBlock Text="문제가 생겼나요?" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <ui:Button Content="{x:Static gui:Titles.Help}" Icon="{ui:SymbolIcon QuestionCircle24}" Appearance="Transparent" Margin="4,0,0,0"
                           FontSize="12" Command="{Binding OpenHelpCommand}" ToolTip="문제 보고용 기록 저장, 디스코드, 자주 묻는 질문이 있습니다." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
