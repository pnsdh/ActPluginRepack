<UserControl x:Class="ActPluginRepack.Gui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Center">
            <TextBlock Text="설정" Style="{StaticResource PageTitle}" />

            <ui:Card Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="게임 위치" Style="{StaticResource Headline}" FontSize="15" />
                        <TextBlock Text="{Binding Games, Converter={StaticResource KeepAll}}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="바꾸기" Icon="{ui:SymbolIcon Folder24}" VerticalAlignment="Center"
                               Command="{Binding EditGamesCommand}" />
                </Grid>
            </ui:Card>

            <!-- 설정한 작업 폴더가 없어져 기본 폴더를 쓰는 중일 때만: 작업 폴더 입력칸은 고급에만 있으므로 간편 모드에도 되돌리는 버튼을 -->
            <ui:Card Padding="20,16" Margin="0,12,0,0" Visibility="{Binding WorkspaceFallback, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="작업 폴더" Style="{StaticResource Headline}" FontSize="15" />
                        <TextBlock Text="{Binding WorkspaceFallback, Converter={StaticResource KeepAll}}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="기본 폴더로 되돌리기" Icon="{ui:SymbolIcon ArrowReset24}" VerticalAlignment="Center"
                               Command="{Binding ResetWorkspaceCommand}"
                               ToolTip="없어진 작업 폴더 설정을 지우고 기본 작업 폴더를 씁니다. 그 폴더의 파일은 건드리지 않습니다." />
                </Grid>
            </ui:Card>

            <!-- 고급 설정 -->
            <StackPanel Visibility="{Binding IsAdvanced, Converter={StaticResource Visible}}">
                <TextBlock Text="고급" Style="{StaticResource SectionLabel}" />
                <ui:Card Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="작업 폴더" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,6"
                                   Text="{Binding Source='input, output, 캐시를 두는 곳입니다. 비워 두면 기본 폴더를 씁니다. 저장소 폴더를 지정하면 CLI 와 같은 데이터를 씁니다.', Converter={StaticResource KeepAll}}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Text="{Binding Workspace, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding DefaultWorkspace}" />
                            <ui:Button Grid.Column="1" Content="찾아보기" Margin="8,0,0,0" Command="{Binding BrowseWorkspaceCommand}" />
                        </Grid>

                        <TextBlock Text="IDA Pro 설치 폴더" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,6"
                                   Text="{Binding Source='opcode 직접 추출용입니다(IDA 9 이상 + Hex-Rays, 라이선스가 필요해 자동으로 받을 수 없습니다). 비워 두면 Program Files 에서 자동으로 찾습니다.', Converter={StaticResource KeepAll}}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Text="{Binding Ida, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding IdaPlaceholder}" />
                            <ui:Button Grid.Column="1" Content="찾아보기" Margin="8,0,0,0" Command="{Binding BrowseIdaCommand}" />
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="로컬 opcodediff" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="{Binding Source='공개본이 없을 때 opcode 를 직접 추출합니다(기본 켜짐). 스크립트·radare2 는 자동으로 받고, Python 3.12 이상이 없으면 휴대용 Python(약 14MB)도 받아 씁니다.', Converter={StaticResource KeepAll}}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding PythonStatus, Converter={StaticResource KeepAll}}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch IsChecked="{Binding LocalDiff}" AutomationProperties.Name="로컬 opcodediff" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                        <ui:TextBox Text="{Binding Python, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                                    PlaceholderText="python.exe 경로 (비우면 py 런처로 자동으로 찾음)" IsEnabled="{Binding LocalDiff}" />

                        <Grid Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="xiv-data-oxidizer 로 CSV 추출" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Text="SharpVision 대신 씁니다(git + Rust 필요)." />
                            </StackPanel>
                            <ui:ToggleSwitch IsChecked="{Binding Oxidizer}" AutomationProperties.Name="xiv-data-oxidizer 로 CSV 추출" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="패치본 배포 기능" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="{Binding Source='고급 모드에 \&quot;패치본 배포 묶음 만들기 (hotfix)\&quot; 를 보여 줍니다. FFXIV_ACT_Plugin_HotFix 저장소에 패치본을 올리는 사람만 켜면 됩니다.', Converter={StaticResource KeepAll}}" />
                            </StackPanel>
                            <ui:ToggleSwitch IsChecked="{Binding Hotfix}" AutomationProperties.Name="패치본 배포 기능" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>

                        <TextBlock Text="SharpVision 실행 파일" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <ui:TextBox Text="{Binding SharpVision, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                                    PlaceholderText="비우면 최신 릴리스를 자동으로 받습니다" />
                    </StackPanel>
                </ui:Card>

                <!-- GitHub API 토큰 -->
                <ui:Card Padding="20,16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="GitHub API 토큰" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   Text="{Binding Source='릴리스·커밋 확인은 토큰이 없으면 GitHub 웹 페이지로 해서 API 한도(IP 당 시간당 60회)를 거의 쓰지 않습니다. 토큰이 있으면 형식이 약속된 API 를 먼저 쓰고(시간당 5000회), 실패하면 웹 페이지로 넘어갑니다. 공개 저장소만 읽으므로 권한을 하나도 주지 않은 토큰이면 충분합니다. 토큰은 이 PC 에 Windows 사용자 계정으로 암호화해 저장하며, 환경 변수 GITHUB_TOKEN 이나 GitHub CLI(gh) 로그인이 있으면 그것을 먼저 씁니다.', Converter={StaticResource KeepAll}}" />
                        <TextBlock Text="{Binding GitHubStatus, Converter={StaticResource KeepAll}}" Style="{StaticResource Body}" FontSize="13" Margin="0,8,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Password 는 기본이 한 방향이라 TwoWay 를 꼭 적는다 (없으면 입력한 토큰이 모델에 안 들어감) -->
                            <ui:PasswordBox Password="{Binding GitHubToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AutomationProperties.Name="GitHub 토큰"
                                            PlaceholderText="github_pat_... 또는 ghp_..." />
                            <ui:Button Grid.Column="1" Content="확인 후 저장" Margin="8,0,0,0" Icon="{ui:SymbolIcon Key24}"
                                       Command="{Binding SaveGitHubTokenCommand}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:Button Content="토큰 만들기 페이지 열기" Icon="{ui:SymbolIcon Open24}" Appearance="Transparent"
                                       Command="{Binding OpenTokenPageCommand}"
                                       ToolTip="GitHub 의 fine-grained 토큰 만들기 페이지를 엽니다. 이름과 만료일만 정하고 권한은 기본값(공개 저장소 읽기)으로 두면 됩니다." />
                            <ui:Button Content="저장한 토큰 지우기" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" Margin="8,0,0,0"
                                       Command="{Binding DeleteGitHubTokenCommand}"
                                       Visibility="{Binding HasSavedToken, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <TextBlock Text="{Binding Message, Converter={StaticResource KeepAll}}" Style="{StaticResource Body}" Margin="0,12,0,0"
                       Visibility="{Binding Message, Converter={StaticResource Visible}}" />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <!-- 간편 모드에는 고칠 칸이 없으므로 [저장]도 없다 (게임 위치·작업 폴더 되돌리기는 각자 바로 저장) -->
                <ui:Button Content="저장" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Padding="24,8" Margin="0,0,12,0" Command="{Binding SaveCommand}"
                           Visibility="{Binding IsAdvanced, Converter={StaticResource Visible}}" />
                <!-- Esc 로도 돌아가기 -->
                <ui:Button Content="돌아가기" IsCancel="{Binding EscGoesBack, Mode=OneTime}" Command="{Binding BackCommand}" />
            </StackPanel>

            <!-- 이 프로그램 정보 -->
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <ui:Button Content="새 버전 / 홈페이지" Icon="{ui:SymbolIcon Open24}" Appearance="Transparent" Margin="8,0,0,0"
                           FontSize="12" Command="{Binding OpenRepoCommand}" ToolTip="이 프로그램의 GitHub 릴리스 페이지를 엽니다." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
